CUT_DANA_MP_ADDON_DIR=/cut-dana-platform-addon
CUT_DANA_BACKEND_DIR=/cut-dana-platform-backend
HOSTNAME=cut-dana-platform.local
HOST_IP=myip
KEYCLOAK_URL=https://auth.cut-dana-platform.local/auth/
KEYCLOAK_CLIENT_ID=backend-client
KEYCLOAK_CLIENT_SECRET=dummy-secret
KEYCLOAK_FRONTEND_CLIENT_ID=masterportal-client
