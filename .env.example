KEYCLOAK_REALM=masterportal
KEYCLOAK_USER=admin
KEYCLOAK_DATABASE_USER=keycloak
KEYCLOAK_DATABASE_PASSWORD=keycloak
DATABASE_HOST=db
DATABASE_PASSWORD=postgres
DATABASE_USER=postgres
DATABASE_PORT=5432
DATABASE_DB=story-backend
MINIO_ACCESS_KEY=abcd
MINIO_DEFAULT_BUCKET=testbucket
MINIO_ENDPOINT=minio.cut-dana-platform.local
MINIO_PORT=443
MINIO_REGION=garage
